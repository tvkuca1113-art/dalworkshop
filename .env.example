# ---------------------------------------------------------------------------
# DAL Workshop — primjer varijabli okruženja. Kopirajte u .env.local.
# Tajne NIKAD ne stavljajte u NEXT_PUBLIC_* varijable.
# ---------------------------------------------------------------------------

# Javni URL produkcije (canonical, sitemap, Open Graph). Ne izmišljati domenu;
# ostavite prazno dok domena nije poznata.
NEXT_PUBLIC_SITE_URL=

# Indeksiranje u pretraživačima: "on" samo za produkciju. Sve drugo = noindex (demo/preview).
SITE_INDEXING=

# --- Web obrazac za upit (server-only) ---------------------------------------
# Obrazac se uključuje tek kad su postavljene SVE varijable ispod (e-mail + rate limit).
# Bez njih stranica pošteno nudi WhatsApp i ispis specifikacije.

# Resend API ključ (https://resend.com) — server-only.
RESEND_API_KEY=
# Verificirani pošiljalac na vlastitoj domeni (npr. upiti@vasa-domena.ba).
# NE koristiti Hotmail adresu kao pošiljaoca.
QUOTE_FROM_EMAIL=
# Primalac upita (može biti javni poslovni e-mail).
QUOTE_TO_EMAIL=dalworkshop@hotmail.com

# Zajednička pohrana za rate limit i zaštitu od duplih upita (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Sol za hash IP adrese u rate limitu (bilo koji dugi nasumični niz).
RATE_LIMIT_SALT=

# --- Samo za lokalno testiranje ------------------------------------------------
# Test transport: upiti se zapisuju kao JSON u ovaj folder umjesto slanja e-maila.
# Nikad ne postavljati u produkciji.
QUOTE_TEST_OUTBOX_DIR=

# --- Javne zastavice (nisu tajne) ----------------------------------------------
# "1" prikazuje end-grain (kockastu) konstrukciju daske — tek nakon potvrde radionice.
NEXT_PUBLIC_FEATURE_END_GRAIN=
# "off" sakriva editor personalizacije ako je radionica isključi.
NEXT_PUBLIC_PERSONALIZATION=
